    <node id="BIDS">
      <data key="d0">BIDS</data>
      <data key="d1">concept</data>
      <data key="d2">A standard for organizing neuroimaging data, referenced as a folder structure that the script can accept as input.&lt;SEP&gt;Brain Imaging Data Structure, a standard for organizing neuroimaging data and file naming.</data>
      <data key="d3">NHP_WRAPPER-chunk-000&lt;SEP&gt;WRAPPER_BINDS-chunk-001</data>
