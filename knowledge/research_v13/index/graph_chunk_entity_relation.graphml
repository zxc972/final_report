    <node id="FSL-VBM">
      <data key="d0">FSL-VBM</data>
      <data key="d1">method</data>
      <data key="d2">A voxel-based morphometry analysis method implemented in FSL, used for structural brain imaging studies.&lt;SEP&gt;A voxel-based morphometry protocol implemented in FSL for processing structural brain images, including registration, modulation, smoothing, and statistical analysis.</data>
      <data key="d3">VBM_TEMPLATE-chunk-000&lt;SEP&gt;VBM_FINAL-chunk-000</data>
      <data key="d4">VBM_TEMPLATE&lt;SEP&gt;VBM_FINAL</data>
      <data key="d5">1792428582</data>
      <data key="d6" />
    </node>
    <node id="Template List">
      <data key="d0">Template List</data>
      <data key="d1">data</data>
      <data key="d2">A file named template_list in the FSL-VBM directory containing the names of selected T1 images used to build a study-specific template.</data>
      <data key="d3">VBM_TEMPLATE-chunk-000</data>
      <data key="d4">VBM_TEMPLATE</data>
      <data key="d5">1792427114</data>
