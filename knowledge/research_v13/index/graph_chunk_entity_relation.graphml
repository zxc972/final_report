    <node id="M1">
      <data key="d0">M1</data>
      <data key="d1">concept</data>
      <data key="d2">A module in the PREEMACS software that performs orientation, cropping, bias correction, averaging, and skull-stripping on neuroimaging data.&lt;SEP&gt;A prior processing step that produces a conformed T1 image used as input for the generateN4 module.&lt;SEP&gt;A modality or pipeline component whose -t1_path and -t2_path parameters must be directories, with each *.nii.gz file inside treated as a run and averaged together.</data>
      <data key="d3">NHP_M1-chunk-000&lt;SEP&gt;NHP_N4-chunk-000&lt;SEP&gt;WRAPPER_BINDS-chunk-000</data>
