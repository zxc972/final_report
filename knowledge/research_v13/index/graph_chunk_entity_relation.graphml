    <node id="Run Full Pipeline Script">
      <data key="d0">Run Full Pipeline Script</data>
      <data key="d1">artifact</data>
      <data key="d2">A shell script that processes neuroimaging data for a subject, taking subject ID, T1 and T2 paths, output directory, and an optional FreeSurfer license as arguments.</data>
      <data key="d3">NHP_WRAPPER-chunk-000</data>
      <data key="d4">NHP_WRAPPER</data>
      <data key="d5">1792427120</data>
      <data key="d6" />
    </node>
    <node id="M3">
      <data key="d0">M3</data>
      <data key="d1">method</data>
      <data key="d2">A dominant component or entity referenced in the input text, likely a model or module that dominates the context.&lt;SEP&gt;A processing step within the pipeline that dominates the total runtime, taking the majority of the 2-3 hours.</data>
      <data key="d3">NHP_WRAPPER-chunk-000&lt;SEP&gt;NHP_WRAPPER-chunk-001</data>
      <data key="d4">NHP_WRAPPER</data>
