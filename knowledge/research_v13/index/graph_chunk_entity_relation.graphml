      <data key="d0">FreeSurfer License</data>
      <data key="d1">artifact</data>
      <data key="d2">An optional license file required for FreeSurfer processing, passed as the fifth argument to the script.</data>
      <data key="d3">NHP_WRAPPER-chunk-000</data>
      <data key="d4">NHP_WRAPPER</data>
      <data key="d5">1792427120</data>
