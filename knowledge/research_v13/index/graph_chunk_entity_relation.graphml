    <node id="Study-Specific Template">
      <data key="d0">Study-Specific Template</data>
      <data key="d1">artifact</data>
      <data key="d2">A template image created from selected T1 images to represent the study population, used for unbiased analysis.&lt;SEP&gt;A template created from the study's own data to which all grey matter images are non-linearly registered.</data>
      <data key="d3">VBM_TEMPLATE-chunk-000&lt;SEP&gt;VBM_FINAL-chunk-000</data>
      <data key="d4">VBM_TEMPLATE&lt;SEP&gt;VBM_FINAL</data>
