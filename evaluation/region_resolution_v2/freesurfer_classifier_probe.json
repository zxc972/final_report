      "line": 3864,
      "text": "#---------------- Cortical Parcellation -----------------#"
    },
    {
      "line": 3865,
      "text": "##---------------       -cortparc       -----------------#"
    },
    {
      "line": 3866,
      "text": "#----------------                       -----------------#"
    },
    {
      "line": 3867,
      "text": "if($DoCortParc) then"
    },
    {
      "line": 3868,
      "text": "  set CMDFS = () # see earlier notes on -parallel implementation"
    },
    {
      "line": 3869,
      "text": "  foreach hemi ($hemilist)"
    },
    {
      "line": 3870,
      "text": "    echo \"#-----------------------------------------\" \\"
    },
    {
      "line": 3871,
      "text": "      |& tee -a $LF |& tee -a $CF"
    },
    {
      "line": 3872,
      "text": "    echo \"#@# Cortical Parc $hemi `date`\" \\"
    },
    {
      "line": 3873,
      "text": "      |& tee -a $SF |& tee -a $LF |& tee -a $CF"
    },
    {
      "line": 3874,
      "text": "    cd $subjdir/scripts > /dev/null"
    },
    {
      "line": 3875,
      "text": "    $PWD |& tee -a $LF"
    },
    {
      "line": 3876,
      "text": "    set xopts = `fsr-getxopts mris_ca_label $XOptsFile $GlobXOptsFile`;"
    },
    {
      "line": 3877,
      "text": "    set CPAtlas = ${GCSDIR}/$hemi.$GCS"
    },
    {
      "line": 3878,
      "text": "    set annot = ../label/$hemi.aparc.annot"
    },
    {
      "line": 3879,
      "text": "    set cmd = (mris_ca_label)"
    },
    {
      "line": 3880,
      "text": "    if($UseAseg) set cmd = ($cmd -l ../label/$hemi.cortex.label)"
    },
    {
      "line": 3881,
      "text": "    if($UseAseg) set cmd = ($cmd -aseg ../mri/aseg.presurf.mgz)"
    },
    {
      "line": 3882,
      "text": "    if($NoRandomness) set cmd = ($cmd -seed $RngSeed)"
    },
    {
      "line": 3883,
      "text": "    set cmd = ($cmd $xopts)"
    },
    {
      "line": 3884,
      "text": "    if($longitudinal) then"
    },
    {
      "line": 3885,
      "text": "      # longitudinal:"
    },
    {
      "line": 3886,
      "text": "      set cmd = ($cmd -long -R $longbasedir/label/${hemi}.aparc.annot)"
    },
    {
      "line": 3887,
      "text": "    endif"
    },
    {
      "line": 3888,
      "text": "    set cmd = ($cmd $subjid $hemi ../surf/$hemi.sphere.reg $CPAtlas $annot)"
    },
    {
      "line": 3889,
      "text": "    echo \"\\n $cmd \\n\" |& tee -a $LF |& tee -a $CF"
    },
    {
      "line": 3890,
      "text": "    if($DoParallel) then"
    },
    {
      "line": 3891,
      "text": "      set CMDF = mris_ca_label_${hemi}.cmd"
    },
    {
      "line": 3892,
      "text": "      echo \"$cmd\" > $CMDF"
    },
    {
      "line": 3893,
      "text": "      set CMDFS = ( $CMDFS $CMDF )"
    },
    {
      "line": 3894,
      "text": "    else"
    },
    {
      "line": 3895,
      "text": "      if($RunIt) $fs_time $cmd |& tee -a $LF"
    },
    {
      "line": 3896,
      "text": "      if($status) goto error_exit;"
    },
    {
      "line": 3897,
      "text": "    endif"
    },
    {
      "line": 3898,
      "text": "    echo $cmd > $touchdir/$hemi.aparc.touch"
    },
    {
      "line": 3899,
      "text": "  end # Loop over hemilist"
    },
