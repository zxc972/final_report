    {
      "line": 8841,
      "text": "NOTIFICATION FILES"
    },
    {
      "line": 8842,
      "text": ""
    },
    {
      "line": 8843,
      "text": "Notification files allow the user to cascade invocations to recon-all,"
    },
    {
      "line": 8844,
      "text": "with one invocation waiting until another one terminates. This is done"
    },
    {
      "line": 9107,
      "text": "Average Curvature (-<no>avgcurv)"
    },
    {
      "line": 9108,
      "text": ""
    },
    {
      "line": 9109,
      "text": "Resamples the average curvature from the atlas to that of the subject."
    },
    {
      "line": 9110,
      "text": "Allows the user to display activity on the surface of an individual"
    },
    {
      "line": 9111,
      "text": "with the folding pattern (ie, anatomy) of a group. Calls mrisp_paint."
    },
    {
      "line": 9112,
      "text": "Creates surf/?h.avg_curv."
    },
    {
      "line": 9113,
      "text": ""
    },
    {
      "line": 9114,
      "text": "Cortical Parcellation (-<no>cortparc, -<no>cortparc2, -<no>cortparc3 )"
    },
    {
      "line": 9115,
      "text": ""
    },
    {
      "line": 9116,
      "text": "Assigns a neuroanatomical label to each location on the cortical surface."
    },
    {
      "line": 9117,
      "text": "Incorporates both geometric information derived from the cortical model"
    },
    {
      "line": 9118,
      "text": "(sulcus and curvature), and neuroanatomical convention."
    },
    {
      "line": 9119,
      "text": "Calls mris_ca_label.  -cortparc creates label/?h.aparc.annot,"
    },
    {
      "line": 9120,
      "text": "-cortparc2 creates /label/?h.aparc.a2009s.annot, and"
    },
    {
      "line": 9121,
      "text": "-cortparc3 creates /label/?h.aparc.DKTatlas40.annot."
    },
    {
      "line": 9122,
      "text": ""
    },
    {
      "line": 9123,
      "text": "Pial Surface (-<no>pial)"
    },
    {
      "line": 9124,
      "text": ""
    },
    {
      "line": 9125,
      "text": "Creates the ?h.pial surfaces as well as the thickness file (?h.thickness)."
    },
    {
      "line": 9126,
      "text": "The pial surface is created by expanding the white surface so that it closely"
    },
    {
      "line": 9127,
      "text": "follows the gray-CSF intensity gradient as found in the T1 volume.  The"
    }
