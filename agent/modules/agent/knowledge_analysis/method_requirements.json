{
  "schema_version": "primatex.method_requirements.v1",
  "scope": "Executable product contracts, not expert-reviewed scientific facts",
  "methods": [
    {
      "method_id": "method:v12:cat_morphometry",
      "required_products": [
        "volume"
      ],
      "needs_parcellation": false,
      "measures": [
        "vbm",
        "sbm"
      ],
      "comparisons": [
        "describe",
        "group"
      ],
      "execution_scope": "full_processing",
      "source": [
        {
          "source_id": "cat",
          "url": "https://neuro-jena.github.io/cat/"
        }
      ],
      "method_facts": [
        {
          "method_fact_id": "method-fact:3e854a95e5a0192845ad62bf",
          "statement": "T1-weighted MRI scans, single scans, longitudinal series or BIDS datasets",
          "source_id": "cat"
        },
        {
          "method_fact_id": "method-fact:90e418b57f89c99ee1c2bbd4",
          "statement": "For MATLAB users, SPM12 or newer and MATLAB R2020a or newer are required; no additional MATLAB toolboxes are needed.",
          "source_id": "cat"
        },
        {
          "method_fact_id": "method-fact:0e8a429af457abd39e5d83be",
          "statement": "Standalone version runs with MATLAB Runtime R2023b and is mainly intended for scripted, headless use on servers and clusters; some features like parallelization and interactive help are not available.",
          "source_id": "cat"
        }
      ],
      "policy_note": "A complete software invocation and scientific prerequisite recipe is still required."
    },
    {
      "method_id": "method:v12:existing_curvature_sulc_profile",
      "required_products": [
        "surface_metric",
        "surface",
        "cortex_label"
      ],
      "needs_parcellation": false,
      "measures": [
        "curv",
        "sulc",
        "thickness"
      ],
      "comparisons": [
        "describe",
        "asymmetry"
      ],
      "execution_scope": "supplied_derivatives",
      "source": [
        {
          "source_id": "nibabel_fs",
          "url": "https://nipy.org/nibabel/reference/nibabel.freesurfer.html"
        },
        {
          "source_id": "numpy_average",
          "url": "https://numpy.org/doc/stable/reference/generated/numpy.average.html"
        },
        {
          "source_id": "numpy_histogram",
          "url": "https://numpy.org/doc/stable/reference/generated/numpy.histogram.html"
        },
        {
          "source_id": "fs_morph",
          "url": "https://surfer.nmr.mgh.harvard.edu/fswiki/FsTutorial/MorphAndRecon"
        }
      ],
      "method_facts": [
        {
          "method_fact_id": "method-fact:a027ecdd0998e4f4f0e749aa",
          "statement": "Provided FreeSurfer-format per-vertex morphometry files.",
          "source_id": "nibabel_fs"
        },
        {
          "method_fact_id": "method-fact:0844d6399f5aab6ed5750f6b",
          "statement": "Corresponding triangular mesh and vertex identities.",
          "source_id": "nibabel_fs"
        },
        {
          "method_fact_id": "method-fact:d98b088c6c1a317458b5f149",
          "statement": "Verify a one-to-one relationship between stored per-vertex values and the selected mesh, using actual lengths and identifiers.",
          "source_id": "nibabel_fs"
        },
        {
          "method_fact_id": "method-fact:cc86387788a414bf46ce2d95",
          "statement": "If a cortex label is used, treat it as an included vertex-index subset and preserve full vertex identity separately.",
          "source_id": "nibabel_fs"
        }
      ],
      "policy_note": "Supplied-derivative reading checks actual products; it does not certify completed reconstruction or anatomical QC."
    },
    {
      "method_id": "method:v12:fsl_vbm",
      "required_products": [
        "gm_4d",
        "gm_mask",
        "subject_table",
        "design_matrix",
        "contrast"
      ],
      "needs_parcellation": false,
      "measures": [
        "vbm",
        "volume"
      ],
      "comparisons": [
        "group"
      ],
      "execution_scope": "full_processing",
      "source": [
        {
          "source_id": "fsl_vbm",
          "url": "https://fsl.fmrib.ox.ac.uk/fsl/docs/structural/fslvbm.html"
        }
      ],
      "method_facts": [
        {
          "method_fact_id": "method-fact:9ad42abde9762f2aff72d17d",
          "statement": "A template_list file containing the names of selected T1 images to be used for template construction, with equal numbers from each group.",
          "source_id": "fsl_vbm"
        },
        {
          "method_fact_id": "method-fact:c627a0c4dd572b15e8235d82",
          "statement": "design.mat and design.con files specifying the cross-subject statistical model, with row order matching the image order from imglob.",
          "source_id": "fsl_vbm"
        },
        {
          "method_fact_id": "method-fact:7c57a4387e8f74aa6b604459",
          "statement": "A GM mask (GM_mask) and the 4D multi-subject concatenated processed data (e.g., GM_mod_merg_s3) for running randomise.",
          "source_id": "fsl_vbm"
        },
        {
          "method_fact_id": "method-fact:e58fe63f7c4cffc9223b373a",
          "statement": "All different populations included in the study must be represented in the template construction.",
          "source_id": "fsl_vbm"
        },
        {
          "method_fact_id": "method-fact:fd7ad338ca1bed84a863779a",
          "statement": "Use the same number of subjects from each group in the template construction to avoid bias in non-linear registration.",
          "source_id": "fsl_vbm"
        },
        {
          "method_fact_id": "method-fact:e2809832f09663cc739db391",
          "statement": "The order of rows in design.mat must match the order of images when doing imglob * in the FSL-VBM directory.",
          "source_id": "fsl_vbm"
        }
      ],
      "policy_note": "A complete software invocation and scientific prerequisite recipe is still required."
    },
    {
      "method_id": "method:v12:hcp_structural_pipeline",
      "required_products": [
        "t1_volume",
        "t2_volume"
      ],
      "needs_parcellation": false,
      "measures": [
        "structural",
        "sbm"
      ],
      "comparisons": [
        "describe"
      ],
      "execution_scope": "full_processing",
      "source": [
        {
          "source_id": "alex_hcp_pdf",
          "url": "https://alexbrain.cn/wp-content/uploads/2025/01/%E4%BD%BF%E7%94%A8HCP-Pipelines%E9%A2%84%E5%A4%84%E7%90%86HCP%E6%95%B0%E6%8D%AE.pdf"
        }
      ],
      "method_facts": [
        {
          "method_fact_id": "method-fact:8464d5a2b0182d16e6ebd5bc",
          "statement": "T1/T2 structural images are processed by the three structural batch scripts.",
          "source_id": "alex_hcp_pdf"
        },
        {
          "method_fact_id": "method-fact:e0d4f1b2d737941bfc09565e",
          "statement": "System: Ubuntu 22.04 LTS was used for testing.",
          "source_id": "alex_hcp_pdf"
        },
        {
          "method_fact_id": "method-fact:46cb5daac2e9d487488e1ea6",
          "statement": "Additional software (python-is-python3 and python3-numpy) were required in practice though not in official docs.",
          "source_id": "alex_hcp_pdf"
        }
      ],
      "policy_note": "A complete software invocation and scientific prerequisite recipe is still required."
    },
    {
      "method_id": "method:v12:local_gyrification",
      "required_products": [
        "pial_surface",
        "recon_complete"
      ],
      "needs_parcellation": false,
      "measures": [
        "lgi"
      ],
      "comparisons": [
        "describe"
      ],
      "execution_scope": "full_processing",
      "source": [
        {
          "source_id": "fs_lgi",
          "url": "https://surfer.nmr.mgh.harvard.edu/fswiki/LGI"
        }
      ],
      "method_facts": [
        {
          "method_fact_id": "method-fact:e3a0f7a199a0616369a52689",
          "statement": "The pial surface file (?h.pial) for the subject, produced by the recon-all -all stream.",
          "source_id": "fs_lgi"
        },
        {
          "method_fact_id": "method-fact:d70d91bea8cd0b8b8d8c4ad1",
          "statement": "The subject's surf directory containing the pial surface files.",
          "source_id": "fs_lgi"
        },
        {
          "method_fact_id": "method-fact:c97946596d1af8bb25717146",
          "statement": "MATLAB with Image Processing Toolbox and $FREESURFER_HOME/matlab in the MATLAB path.",
          "source_id": "fs_lgi"
        },
        {
          "method_fact_id": "method-fact:d4f50f947f3e85a0aec16506",
          "statement": "The subject must have been processed with the full recon-all stream before using -localGI.",
          "source_id": "fs_lgi"
        },
        {
          "method_fact_id": "method-fact:a57a64d55b4ab23e45cfbb8d",
          "statement": "MATLAB and its Image Processing Toolbox must be installed and accessible.",
          "source_id": "fs_lgi"
        },
        {
          "method_fact_id": "method-fact:f3a07cba56e858772c3a351f",
          "statement": "The MATLAB path must include $FREESURFER_HOME/matlab, set up in ~/matlab/startup.m.",
          "source_id": "fs_lgi"
        }
      ],
      "policy_note": "A complete software invocation and scientific prerequisite recipe is still required."
    },
    {
      "method_id": "method:v12:macaque_civet",
      "required_products": [
        "t1_volume",
        "template",
        "tissue_priors"
      ],
      "needs_parcellation": false,
      "measures": [
        "structural",
        "thickness"
      ],
      "comparisons": [
        "describe"
      ],
      "execution_scope": "full_processing",
      "source": [
        {
          "source_id": "civet_macaque",
          "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC7615896/"
        },
        {
          "source_id": "nmt",
          "url": "https://afni.nimh.nih.gov/pub/dist/doc/htmldoc/nonhuman/macaque_tempatl/template_nmtv2.html"
        }
      ],
      "method_facts": [
        {
          "method_fact_id": "method-fact:68902476c77c3bd04c6a03a2",
          "statement": "T1-weighted MR scan of a macaque brain as the primary input.",
          "source_id": "civet_macaque"
        },
        {
          "method_fact_id": "method-fact:bcba226139e7fee3b4e7687a",
          "statement": "Optional T2-weighted or proton density scans for multimodal tissue classification.",
          "source_id": "civet_macaque"
        },
        {
          "method_fact_id": "method-fact:06e61d111cfe853cec9bc678",
          "statement": "NMT brain mask and tissue priors for registration and classification.",
          "source_id": "civet_macaque"
        },
        {
          "method_fact_id": "method-fact:cdb4c578ea1672c8fa63136f",
          "statement": "The pipeline is designed for macaque brains and uses a length scale of 0.4 relative to human brain size.",
          "source_id": "civet_macaque"
        },
        {
          "method_fact_id": "method-fact:b56101bc965bf17a5b56ec8c",
          "statement": "Processing is performed in the NMT standardized space.",
          "source_id": "civet_macaque"
        },
        {
          "method_fact_id": "method-fact:b4aaa5b78e6d20b6af346666",
          "statement": "The pipeline requires T1w scans; T2-weighted or proton density scans are optional for multimodal classification.",
          "source_id": "civet_macaque"
        },
        {
          "method_fact_id": "method-fact:dfe3f57ed4a1d99a9b6764e8",
          "statement": "The NMT v2 is the current version of the template, with symmetric and asymmetric variants and multiple resolutions.",
          "source_id": "nmt"
        }
      ],
      "policy_note": "A complete software invocation and scientific prerequisite recipe is still required."
    },
    {
      "method_id": "method:v12:nhp_macapype",
      "required_products": [
        "bids_t1",
        "bids_t2",
        "parameter_file"
      ],
      "needs_parcellation": false,
      "measures": [
        "structural",
        "segmentation"
      ],
      "comparisons": [
        "describe"
      ],
      "execution_scope": "full_processing",
      "source": [
        {
          "source_id": "macapype_commands",
          "url": "https://macatools.github.io/macapype/command.html"
        },
        {
          "source_id": "nmt",
          "url": "https://afni.nimh.nih.gov/pub/dist/doc/htmldoc/nonhuman/macaque_tempatl/template_nmtv2.html"
        }
      ],
      "method_facts": [
        {
          "method_fact_id": "method-fact:3e065f551fd06cfa7eaafbf5",
          "statement": "Input data must be in BIDS format, with T1w and T2w images expected.",
          "source_id": "macapype_commands"
        },
        {
          "method_fact_id": "method-fact:9f5670a62a149ef9cb7e7caf",
          "statement": "T1 weighted images are expected with the _T1w BIDS extension.",
          "source_id": "macapype_commands"
        },
        {
          "method_fact_id": "method-fact:d316b8bc320b59f8ce3b7c22",
          "statement": "T2 weighted images are expected with the _T2w BIDS extension.",
          "source_id": "macapype_commands"
        },
        {
          "method_fact_id": "method-fact:f98dd3ad8ad6ba6342757f96",
          "statement": "All files with the same extension (T1w or T2w) will be aligned to the first one and averaged.",
          "source_id": "macapype_commands"
        },
        {
          "method_fact_id": "method-fact:e02bc3a363ec380d35e9214b",
          "statement": "The -data parameter must point to an existing BIDS format directory.",
          "source_id": "macapype_commands"
        },
        {
          "method_fact_id": "method-fact:f31b182905a8e9759a9ab145",
          "statement": "The -out parameter must point to an existing output path.",
          "source_id": "macapype_commands"
        },
        {
          "method_fact_id": "method-fact:b905d5f0b2d35bb336f75bdf",
          "statement": "The -soft parameter must be either SPM or ANTS, with SPM requiring a specific version of macapype/skullTo3d not available by default.",
          "source_id": "macapype_commands"
        },
        {
          "method_fact_id": "method-fact:789957ac663dc99c52a412c8",
          "statement": "Either -params or -species must be provided; -params is mandatory if -species is omitted, and vice versa.",
          "source_id": "macapype_commands"
        }
      ],
      "policy_note": "A complete software invocation and scientific prerequisite recipe is still required."
    },
    {
      "method_id": "method:v12:samseg_segmentation",
      "required_products": [
        "volume"
      ],
      "needs_parcellation": false,
      "measures": [
        "segmentation",
        "volume"
      ],
      "comparisons": [
        "describe"
      ],
      "execution_scope": "full_processing",
      "source": [
        {
          "source_id": "fs_samseg",
          "url": "https://surfer.nmr.mgh.harvard.edu/fswiki/Samseg"
        },
        {
          "source_id": "alex_samseg_pdf",
          "url": "https://alexbrain.cn/wp-content/uploads/2025/04/%E4%BD%BF%E7%94%A8Samseg%E8%BF%9B%E8%A1%8C%E5%85%A8%E8%84%91%E5%88%86%E5%89%B2.pdf"
        }
      ],
      "method_facts": [
        {
          "method_fact_id": "method-fact:974ea99771621348a5584ea5",
          "statement": "One or more co-registered MRI volumes in Nifti (.nii/.nii.gz) or FreeSurfer (.mgz) format.",
          "source_id": "fs_samseg"
        },
        {
          "method_fact_id": "method-fact:efecf0fee0082393043f4119",
          "statement": "All input volumes must be co-registered with each other and have the same image grid size and voxel dimensions.",
          "source_id": "fs_samseg"
        },
        {
          "method_fact_id": "method-fact:a0c95075f951f7c25b344347",
          "statement": "For multi-contrast data, it is recommended to select the contrast with the highest spatial resolution and reformat all other contrasts to that grid.",
          "source_id": "fs_samseg"
        },
        {
          "method_fact_id": "method-fact:3fe5630af62dd7223fbeec3b",
          "statement": "For longitudinal processing, all time points must be co-registered and reformatted to the same image grid, using an unbiased reference template.",
          "source_id": "fs_samseg"
        },
        {
          "method_fact_id": "method-fact:3bfe0cfe0b172a6162f66321",
          "statement": "Preprocessing with FreeSurfer is neither required nor recommended for basic SAMSEG.",
          "source_id": "fs_samseg"
        },
        {
          "method_fact_id": "method-fact:4de9be45358e3e1c2a71fb12",
          "statement": "For multi-contrast input, all volumes must be co-registered and have the same image grid size and voxel dimensions.",
          "source_id": "fs_samseg"
        },
        {
          "method_fact_id": "method-fact:8d0582621a12f030139b4d40",
          "statement": "For longitudinal SAMSEG, the same combination of contrasts must be provided for each time point.",
          "source_id": "fs_samseg"
        },
        {
          "method_fact_id": "method-fact:7c2e516be538f5bd0f4833f4",
          "statement": "When using the lesion flag, the lesion-mask-pattern is optional but strongly recommended.",
          "source_id": "fs_samseg"
        }
      ],
      "policy_note": "A complete software invocation and scientific prerequisite recipe is still required."
    },
    {
      "method_id": "method:v12:surface_annotation_roi",
      "required_products": [
        "surface_metric",
        "annotation",
        "cortex_label",
        "surface",
        "registration_surface"
      ],
      "needs_parcellation": true,
      "measures": [
        "thickness",
        "curv",
        "sulc",
        "area",
        "volume"
      ],
      "comparisons": [
        "describe",
        "asymmetry",
        "group",
        "correlation",
        "cross_species"
      ],
      "execution_scope": "supplied_derivatives",
      "source": [
        {
          "source_id": "nibabel_fs",
          "url": "https://nipy.org/nibabel/reference/nibabel.freesurfer.html"
        },
        {
          "source_id": "andy_roi",
          "url": "https://andysbrainbook.readthedocs.io/en/latest/FreeSurfer/FS_ShortCourse/FS_11_ROIAnalysis.html"
        },
        {
          "source_id": "fs_parcstats",
          "url": "https://www.freesurfer.net/fswiki/parcstats"
        }
      ],
      "method_facts": [
        {
          "method_fact_id": "method-fact:1c150a35562383188f51cb4a",
          "statement": "A FreeSurfer annotation (.annot) file containing a label value per vertex plus a color table.",
          "source_id": "nibabel_fs"
        },
        {
          "method_fact_id": "method-fact:11bed30ee564aa991d4926ed",
          "statement": "A FreeSurfer morphometry file (curv-type, e.g. ?h.curv, ?h.thickness) holding one value per vertex.",
          "source_id": "nibabel_fs"
        },
        {
          "method_fact_id": "method-fact:3b74adb32cb4a1624251c912",
          "statement": "Optionally a FreeSurfer .label file giving vertex indices, with optional per-vertex scalars.",
          "source_id": "nibabel_fs"
        },
        {
          "method_fact_id": "method-fact:6845313ae380dd39c60d3d96",
          "statement": "Optionally a triangular surface mesh geometry file supplying vertex coordinates and faces.",
          "source_id": "nibabel_fs"
        },
        {
          "method_fact_id": "method-fact:63efa81b48f41daf378e19a6",
          "statement": "Annotation file format versions 1 and 2 are supported, corresponding to old-style and new-style color table layouts.",
          "source_id": "nibabel_fs"
        },
        {
          "method_fact_id": "method-fact:0b90a4102963b2f8bab017ef",
          "statement": "The returned color table is in RGBT form, where transparency T is 255 minus alpha.",
          "source_id": "nibabel_fs"
        },
        {
          "method_fact_id": "method-fact:44c05d9e9a8e92569b91a711",
          "statement": "Morphometry values written must have shape (N,), (N, 1), (1, N) or (N, 1, 1).",
          "source_id": "nibabel_fs"
        }
      ],
      "policy_note": "Supplied-derivative reading checks actual products; it does not certify completed reconstruction or anatomical QC."
    },
    {
      "method_id": "method:v12:surface_mesh_area",
      "required_products": [
        "surface"
      ],
      "needs_parcellation": false,
      "measures": [
        "area"
      ],
      "comparisons": [
        "describe",
        "asymmetry"
      ],
      "execution_scope": "supplied_derivatives",
      "source": [
        {
          "source_id": "trimesh_triangles",
          "url": "https://trimesh.org/trimesh.triangles.html"
        },
        {
          "source_id": "nibabel_fs",
          "url": "https://nipy.org/nibabel/reference/nibabel.freesurfer.html"
        },
        {
          "source_id": "fs_parcstats",
          "url": "https://www.freesurfer.net/fswiki/parcstats"
        }
      ],
      "method_facts": [
        {
          "method_fact_id": "method-fact:8f69ecb5f951469ddbdd0c33",
          "statement": "A FreeSurfer surface mesh file in triangular format, e.g., white or pial surface.",
          "source_id": "nibabel_fs"
        },
        {
          "method_fact_id": "method-fact:26fc0ec3f338af90ac11069a",
          "statement": "Vertex coordinates array (nvtx x 3) from the surface mesh.",
          "source_id": "nibabel_fs"
        },
        {
          "method_fact_id": "method-fact:a9f022a61dcd1c5c01d87b5f",
          "statement": "Face array (nfaces x 3) defining mesh triangles.",
          "source_id": "nibabel_fs"
        },
        {
          "method_fact_id": "method-fact:8942bb47b6a4f0aeaf345d76",
          "statement": "Triangle vertices in (n, 3, 3) float form for area computation.",
          "source_id": "trimesh_triangles"
        },
        {
          "method_fact_id": "method-fact:0d57ccee2736fc9db8090faa",
          "statement": "The mesh must be in triangular format as read by nibabel's read_geometry.",
          "source_id": "nibabel_fs"
        },
        {
          "method_fact_id": "method-fact:410057b0179e37e6a718d036",
          "statement": "Triangle vertices must be provided as an (n, 3, 3) float array for area calculation.",
          "source_id": "trimesh_triangles"
        },
        {
          "method_fact_id": "method-fact:4e9b2a5bc08fed295f60acc9",
          "statement": "The area function computes the sum area of input triangles.",
          "source_id": "trimesh_triangles"
        }
      ],
      "policy_note": "Supplied-derivative reading checks actual products; it does not certify completed reconstruction or anatomical QC."
    },
    {
      "method_id": "method:v12:surface_reconstruction_qc",
      "required_products": [
        "volume",
        "surface"
      ],
      "needs_parcellation": false,
      "measures": [
        "qc"
      ],
      "comparisons": [
        "describe"
      ],
      "execution_scope": "supplied_derivatives",
      "source": [
        {
          "source_id": "andy_failures",
          "url": "https://andysbrainbook.readthedocs.io/en/latest/FreeSurfer/FS_ShortCourse/FS_12_FailureModes.html"
        },
        {
          "source_id": "fs_morph",
          "url": "https://surfer.nmr.mgh.harvard.edu/fswiki/FsTutorial/MorphAndRecon"
        }
      ],
