{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Server-controlled table reference contract v1",
  "description": "Load only through the server-configured ArtifactValidator constructor; store outside the model work directory. Never expose reference values in model tools.",
  "type": "object",
  "required": [
    "schema_version",
    "tables"
  ],
  "properties": {
    "schema_version": {
      "const": "primatex.analysis_reference.v1"
    },
    "tables": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "artifact_path",
          "reference_path",
          "key_columns",
          "value_columns"
        ],
        "properties": {
          "artifact_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^(?!/)(?!.*[\\\\:])(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\x00\\r\\n]+$"
          },
          "reference_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^(?!/)(?!.*[\\\\:])(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\x00\\r\\n]+$"
          },
          "reference_kind": {
            "enum": [
              "csv",
              "tsv"
            ]
          },
          "key_columns": {
            "type": "array",
            "maxItems": 256,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "minItems": 1
          },
          "value_columns": {
            "type": "array",
            "maxItems": 256,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "minItems": 1
          },
          "exact_columns": {
            "type": "array",
            "maxItems": 256,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "rtol": {
            "type": "number",
            "minimum": 0
          },
          "atol": {
            "type": "number",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
