  "properties": {
    "subject": {
      "type": "string",
      "nullable": true,
      "trust": "authenticated registration or explicit subject table"
    },
    "species": {
      "type": "enum",
      "values": [
        "human",
        "macaque",
        "marmoset",
        "chimpanzee",
        "monkey_unknown",
        "unknown"
      ],
      "nullable": true,
      "declared_and_verified_separate": true,
      "no_filename_inference": true
    },
    "hemisphere": {
      "type": "enum",
      "values": [
        "lh",
        "rh",
        "bilateral",
        "unknown"
      ],
      "nullable": true,
      "source_required": true
    },
    "space": {
      "type": "enum",
      "values": [
        "native",
        "fsaverage",
        "fsLR_32k",
        "fsLR_164k",
        "MNI152",
        "NMT_v2",
        "Yerkes19"
      ],
      "nullable": true,
      "unknown_is_not_native": true
    },
    "mesh": {
      "type": "integer",
      "minimum": 1,
      "nullable": true,
      "meaning": "Full-mesh vertex count read from geometry/metric/annotation; cortex label length is not mesh size"
    },
    "atlas": {
      "type": "string",
      "nullable": true,
      "label_id_scheme_must_be_explicit": true
    },
    "label_table": {
      "type": "array",
      "items": "string",
      "nullable": true
    },
    "measure": {
      "type": "string",
      "nullable": true
    },
    "unit": {
      "type": "string",
      "nullable": true,
      "software_convention_and_physical_verification_separate": true
    },
    "voxel_size": {
      "type": "array",
      "items": "number",
      "length": 3,
      "nullable": true
    },
    "scale_status": {
      "type": "object",
      "fields": {
        "rescaled": "boolean|null",
        "factor": "number|null",
        "basis": "string",
        "verified": "boolean"
      },
      "nullable": true
    },
    "columns": {
      "type": "array",
      "items": "string",
      "nullable": true
    },
    "n_subjects": {
      "type": "integer",
      "minimum": 0,
      "nullable": true,
      "distinct_subjects_not_scans": true
    },
    "from_space": {
      "type": "enum",
      "values": [
        "native",
        "fsaverage",
        "fsLR_32k",
        "fsLR_164k",
        "MNI152",
        "NMT_v2",
        "Yerkes19"
      ],
      "nullable": true
    },
    "to_space": {
      "type": "enum",
      "values": [
        "native",
        "fsaverage",
        "fsLR_32k",
        "fsLR_164k",
        "MNI152",
        "NMT_v2",
        "Yerkes19"
      ],
      "nullable": true
    },
    "vector_ndim": {
      "type": "integer",
      "minimum": 0,
      "nullable": true
    },
    "face_width": {
      "type": "integer",
      "minimum": 1,
      "nullable": true
    },
    "nonempty_columns": {
      "type": "object",
      "nullable": true,
      "meaning": "observed nonempty cells per TSV column"
    }
  },
